# benpage — NeteaseCloudMusicApi sidecar (resolves CDN URLs for the
# Recordings tab's NetEase Cloud Music playback source).
#
# The sidecar listens ONLY on 127.0.0.1 — never expose it publicly.
#
#   sudo cp deploy/netease-api.service /etc/systemd/system/netease-api.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now netease-api
#   sudo systemctl status netease-api
#
# Optional: higher-quality playback with your own account — run the QR login
# flow (see deploy/netease-setup.md §4); the session cookies persist in the
# sidecar process.

[Unit]
Description=NeteaseCloudMusicApi sidecar for benpage
After=network.target

[Service]
Type=simple
# ⚠️ 若 node 是 nvm 安装的：不要用 www-data——它无法读取 /home/<user>/.nvm
#    (权限 700)，而且 nvm 的 npm 全局 bin 软链依赖 PATH 里的 node。
#    请把 User/Group 改成 nvm 的属主，并把 PATH 指到 nvm 的 bin 目录，例如：
#       User=ubuntu
#       Group=ubuntu
#       Environment=PATH=/home/ubuntu/.nvm/versions/node/v22.14.0/bin:/usr/local/bin:/usr/bin:/bin
#    这样下面的默认 ExecStart 和预检就都能直接工作，无需改绝对路径。
User=www-data
Group=www-data
Environment=PORT=3001
ExecStart=/usr/bin/env PORT=3001 NeteaseCloudMusicApi
# 预检只告警、绝不阻断：命令不在服务用户 PATH 时在 journal 里打印提示，
# 但不会挡住"ExecStart 已用绝对路径 / 已按 nvm 配置 User+PATH"的部署。
ExecStartPre=/bin/sh -c 'if ! command -v NeteaseCloudMusicApi >/dev/null 2>&1; then echo "warning: NeteaseCloudMusicApi 不在服务用户 PATH 中 —— 若 ExecStart 已用绝对路径或已按注释配置 nvm 的 User/PATH 可忽略；否则请安装: sudo npm i -g NeteaseCloudMusicApi"; fi; exit 0'
Restart=on-failure
RestartSec=5
# 常见做法（任选其一）：
#   · 系统 node（最省心）:
#       curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash -
#       sudo apt-get install -y nodejs
#       sudo npm install -g NeteaseCloudMusicApi
#   · nvm node: 按上面注释把 User/Group/PATH 配成 nvm 属主，保持默认 ExecStart；
#     或用绝对路径（注意 www-data 读不到 /home/<user>）:
#       ExecStart=/usr/bin/env PORT=3001 /home/<user>/.nvm/versions/node/v22.x/bin/NeteaseCloudMusicApi
#   · 直接让 nvm 的 node 跑入口文件（绕开软链和 shebang，仍需 User 为 nvm 属主）:
#       ExecStart=/home/<user>/.nvm/versions/node/v22.x/bin/node /home/<user>/.nvm/versions/node/v22.x/lib/node_modules/NeteaseCloudMusicApi/app.js
# Hardening — this process only makes outbound https calls to NetEase.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
