# benpage.service — systemd unit example
# =========================================
#
# CRASH YOU SAW:
#   benpage.service: Main process exited, code=dumped, status=11/SEGV
#   benpage.service: Failed with result 'core-dump'.
#
# CAUSE:
#   SIGSEGV at startup = the better-sqlite3 NATIVE addon crashed on load.
#   better-sqlite3 v13 (this project) requires Node.js >= 22.
#   If the Node used by this service is older (18/20 — common on Aliyun ECS),
#   requiring better-sqlite3 segfaults immediately: status=11/SEGV.
#
# FIX (run on the server, in the app directory):
#   1) Check the Node version that systemd uses:
#        which node && node -v
#   2) If < v22, install Node LTS v22 (Debian/Ubuntu example):
#        curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash -
#        sudo apt-get install -y nodejs
#   3) Reinstall deps (native addon must match the NEW Node):
#        cd /var/www/benpage
#        rm -rf node_modules package-lock.json && npm install
#   4) Verify before starting:
#        npm run check
#   5) Reload and restart:
#        sudo systemctl daemon-reload
#        sudo systemctl restart benpage
#        sudo systemctl status benpage
#
# NOTES:
#   - Never copy node_modules between machines/architectures — always
#     run `npm install` ON the server so the native addon is built/selected
#     for the server's Node + glibc.
#   - The SQLite DB (data/benpage.db) is now gitignored so a stale or
#     WAL-inconsistent copy can never be deployed again (another crash source).
#
# Install:
#   sudo cp deploy/benpage.service /etc/systemd/system/benpage.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now benpage

[Unit]
Description=Node.js ben page Service
After=network.target

[Service]
# ── Critical: use the FULL PATH of a Node v22+ binary ──────────────
# Find it with:  which node     (must print /usr/bin/node or /usr/local/bin/node)
# If you installed via NodeSource it stays at /usr/bin/node.
# DO NOT rely on a modified PATH from your shell — systemd strips it.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Optionally: Environment=NODE_ENV=production

Type=simple
# Use npm start so the package.json "start" script runs (no hardcoded port issue)
ExecStart=/usr/bin/npm start --prefix /var/www/benpage
WorkingDirectory=/var/www/benpage
Restart=on-failure
RestartSec=3

# Strong hardening (safe for this app — no root, no network features needed)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/benpage/data

[Install]
WantedBy=multi-user.target